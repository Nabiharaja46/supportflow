# ---- Server secrets (never mirrored in /client) ----
# Copy this file to .env and fill in real values.

# MongoDB connection string (Atlas or local mongod)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/supportflow

# Long random string for signing JWTs (later phases)
JWT_SECRET=change-me-to-a-long-random-string

# Google Gemini API key (later phases, server-side only)
GEMINI_API_KEY=change-me

# Port for the Express API
PORT=5000

# Allowed browser origin (the Vite dev server)
CLIENT_URL=http://localhost:5173