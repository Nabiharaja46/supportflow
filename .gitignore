# ---- SupportFlow root .gitignore ----
# Secrets / environment files (never commit these)
.env
.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/

# Build outputs
dist/
build/

# Logs
*.log
npm-debug.log*

# Editor / OS noise
.DS_Store
Thumbs.db
.vscode/launch.json
coverage/

# Temp files
tmp-*.mjs
tmp-*.json
tmp-*.cjs